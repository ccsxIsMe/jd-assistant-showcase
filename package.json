{
  "name": "jd-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "prepare:demo": "node scripts/prepare-demos.mjs",
    "prepare:pdf": "node scripts/prepare-pdf.mjs",
    "postinstall": "node scripts/prepare-pdf.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:client-boundary": "node scripts/verify-client-boundary.mjs",
    "test:connection": "node scripts/test-deepseek-connection.mjs",
    "test:suggestion": "node scripts/test-local-suggestion.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "ai:examples": "node scripts/export-ai-examples.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:public": "node scripts/check-public-package.mjs"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.72",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.0",
    "@xyflow/react": "12.12.0",
    "ai": "7.0.152",
    "cheerio": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ipaddr.js": "2.5.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.11.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "docx": "^9.5.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.7.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24.14.1 <25"
  }
}
